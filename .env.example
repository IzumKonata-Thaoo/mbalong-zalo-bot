# Web admin
PORT=8787
HOST=127.0.0.1
ADMIN_PASSWORD=change-this-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Zalo IDs allowed to administer the bot, comma-separated.
# Find IDs after first login in the web member list or from server logs.
ZALO_ADMIN_IDS=

# AI Base URL, model and API key are configured in the admin website.

# Optional web research. Supports Tavily-compatible /search.
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_KEY=

# Public SoundCloud search through yt-dlp; no SoundCloud account/API key needed.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Runtime
DATABASE_PATH=./data/bot.db
SESSION_PATH=./data/zalo-session.json
# Set this to the stable HTTPS hostname provided by Cloudflare Tunnel.
PUBLIC_ORIGIN=http://localhost:8787
BOT_NAME=MbaLong
